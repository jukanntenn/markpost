# {{ ansible_managed }}
# markpost Caddyfile (production).
#
# Plain HTTP only. TLS terminates on the host Caddy gateway (port 443,
# Cloudflare Origin CA cert, Full strict), which reverse-proxies to the
# loopback-published port below; because the published port binds 127.0.0.1,
# the host gateway is the only possible peer.
#
# trusted_proxies: private ranges cover the gateway's NAT'd bridge address as
# seen from the container. The default XFF append is superseded by the
# header_up rewrite: CF-Connecting-IP passes through the gateway untouched
# (not a hop-by-hop header), so the XFF reaching Go is always the single
# Cloudflare-asserted client IP.
# Internal layout: Caddy :{{ caddy_port }}, Go backend 127.0.0.1:7330.

{
	auto_https off
}

:{{ caddy_port }} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:7330 {
			trusted_proxies private_ranges
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:7330 {
			trusted_proxies private_ranges
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /swagger/* {
		reverse_proxy 127.0.0.1:7330 {
			trusted_proxies private_ranges
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /mpk-* {
		reverse_proxy 127.0.0.1:7330 {
			trusted_proxies private_ranges
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /p-* {
		reverse_proxy 127.0.0.1:7330 {
			trusted_proxies private_ranges
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		root * /app/frontend

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Static HTML pages (/, /login, /dashboard, ...) leave the origin
		# cacheable so the CDN edge can absorb repeat navigations; without a
		# Cache-Control the export's HTML is uncached by default and every
		# page view re-originate. 5 minutes bounds brand-shell staleness.
		@pageHtml not path /_next/static/*
		header @pageHtml Cache-Control "public, max-age=300"

		@noExt {
			not file
			path_regexp ^/([^.]+)$
		}
		rewrite @noExt /{http.regexp.1}.html
		file_server
	}

	# BUG-1: serve the branded 404.html (built by the static export) instead of
	# Caddy's blank default when no static file or rewritten .html matches.
	# handle_errors keeps the 404 status code; the rewrite only swaps the body.
	handle_errors 404 {
		root * /app/frontend
		rewrite * /404.html
		file_server
	}

	log {
		output stderr
		format console
	}
}
