# Markpost Environment Variables
# Copy this file to .env and edit as needed.
# See https://github.com/jukanntenn/markpost for details.

# ── Admin (only effective on first boot, changing later has no effect) ──
MARKPOST_ADMIN__INITIAL_USERNAME=markpost
MARKPOST_ADMIN__INITIAL_PASSWORD=markpost

# ── JWT (change these to random strings!) ──
MARKPOST_JWT__ACCESS_SIGNING_KEY=change-me
MARKPOST_JWT__REFRESH_SIGNING_KEY=change-me

# ── Server ──
# MARKPOST_SERVER__PUBLIC_URL=https://markpost.example.com
# MARKPOST_TIMEZONE=UTC

# ── Observability ──
# JSONL logs/traces/metrics land in the bind-mounted ./data/logs on the host.
# MARKPOST_OBSERVABILITY__LOG_DIR=/app/data/logs

# ── PostgreSQL (POSTGRES_PASSWORD is shared with the postgres service) ──
POSTGRES_DB=markpost
POSTGRES_USER=markpost
POSTGRES_PASSWORD=markpost

# ── Post retention ──
# MARKPOST_POST__RETENTION_DAYS=7
