      "description": "markpost.delivery.pending — the queue depth; the backlog alerts key on this gauge.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "60s",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "markpost.delivery.pending{deployment.environment.name=~\"$env\"}",
          "legendFormat": "{{deployment.environment.name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pending attempts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "interval": "60s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (deployment.environment.name) (rate(markpost.delivery.dispatched_total{deployment.environment.name=~\"$env\"}[5m]))",
          "legendFormat": "{{deployment.environment.name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Dispatched rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "id": 3,
      "interval": "60s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (deployment.environment.name, error_category) (rate(markpost.delivery.failed_total{deployment.environment.name=~\"$env\"}[5m]))",
          "legendFormat": "{{deployment.environment.name}} {{error_category}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failed rate by error category",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "markpost.delivery.duration — enqueue to dispatch per attempt, retries included; the bucket ladder tops above the 40-minute expiry wall.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "interval": "60s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (deployment.environment.name, le) (rate(markpost.delivery.duration_bucket{deployment.environment.name=~\"$env\"}[5m])))",
          "legendFormat": "p50 {{deployment.environment.name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (deployment.environment.name, le) (rate(markpost.delivery.duration_bucket{deployment.environment.name=~\"$env\"}[5m])))",
          "legendFormat": "p95 {{deployment.environment.name}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (deployment.environment.name, le) (rate(markpost.delivery.duration_bucket{deployment.environment.name=~\"$env\"}[5m])))",
          "legendFormat": "p99 {{deployment.environment.name}}",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Enqueue-to-dispatch duration quantiles",
      "type": "timeseries"
    }
