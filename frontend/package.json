    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.0.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "intl-messageformat": "^11.2.12",
    "jsdom": "^27.0.1",
    "msw": "^2.12.7",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vitest": "^4.0.4"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
