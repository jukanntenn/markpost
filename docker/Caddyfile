:2053 {
	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:7330
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:7330
	}

	handle /swagger/* {
		reverse_proxy 127.0.0.1:7330
	}

	handle /mpk-* {
		reverse_proxy 127.0.0.1:7330
	}

	handle /p-* {
		reverse_proxy 127.0.0.1:7330
	}

	handle {
		root * /app/frontend

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@noExt {
			not file
			path_regexp ^/([^.]+)$
		}
		rewrite @noExt /{http.regexp.1}.html
		file_server
	}

	# BUG-1: serve the branded 404.html (built by the static export) instead of
	# Caddy's blank default when no static file or rewritten .html matches.
	# handle_errors keeps the 404 status code; the rewrite only swaps the body.
	handle_errors 404 {
		root * /app/frontend
		rewrite * /404.html
		file_server
	}

	log {
		output stderr
		format console
	}
}
