# {{ ansible_managed }}
# Environment for the scheduled backup scripts (MRFC
# 2026-07-09-wal-archival-disaster-recovery). 0600 — carries the vaulted B2 key
# pair; sourced by pgbackrest-check.sh / pg-dump-backup.sh /
# pgbackrest-drill.sh. The rclone dump and the pgBackRest repo share one
# no-delete application key on purpose: both only ever add objects. Guarded
# like config.toml.j2's optional knobs: the templating task itself only runs
# with the vault vars defined, and the guard keeps renders inert without them.
{% if b2_repo_key_id is defined %}
B2_S3_ENDPOINT={{ b2_s3_endpoint }}
B2_S3_REGION={{ b2_s3_region }}
B2_ACCESS_KEY_ID={{ b2_repo_key_id }}
B2_SECRET_ACCESS_KEY={{ b2_repo_app_key }}
{% if kuma_backup_url is defined %}
KUMA_BACKUP_URL={{ kuma_backup_url }}
{% endif %}
{% endif %}
